{
  "info": {
    "name": "Travlr Module Seven Security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Module7-Test-Password!"
    },
    {
      "key": "tripCode",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Public listing\") {",
          "  const id = Date.now();",
          "  pm.collectionVariables.set(\"email\", \"module7-\" + id + \"@example.test\");",
          "  pm.collectionVariables.set(\"tripCode\", \"M7\" + id);",
          "  pm.collectionVariables.set(\"token\", \"\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Public listing",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/trips"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Anonymous create rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/trips",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{tripCode}}\",\n  \"name\": \"Module Seven Test Trip\",\n  \"length\": \"5 days\",\n  \"start\": \"2027-01-10\",\n  \"resort\": \"Test Resort\",\n  \"perPerson\": \"500\",\n  \"image\": \"reef1.jpg\",\n  \"description\": \"Temporary Postman security test.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
