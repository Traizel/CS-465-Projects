{
  "info": {
    "name": "Travlr Module Five REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run after npm run seed. Tests both trip retrieval routes, missing data, unknown routes, and the API-driven Travel page."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "All trips",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const tripResponse = pm.response.json();",
              "pm.test('Expected response body', () => {",
              "pm.expect(Array.isArray(tripResponse)).to.eql(true);",
              "pm.expect(tripResponse.length).to.eql(3);",
              "pm.expect(tripResponse.map(t => t.code)).to.include('GALR210214');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Gale Reef by code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/GALR210214"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const tripResponse = pm.response.json();",
              "pm.test('Expected response body', () => {",
              "pm.expect(tripResponse.length).to.eql(1);",
              "pm.expect(tripResponse[0].code).to.eql('GALR210214');",
              "pm.expect(tripResponse[0].name).to.eql('Gale Reef');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Dawsons Reef by code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/DAWR210315"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const tripResponse = pm.response.json();",
              "pm.test('Expected response body', () => {",
              "pm.expect(tripResponse.length).to.eql(1);",
              "pm.expect(tripResponse[0].code).to.eql('DAWR210315');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Claires Reef by code",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/CLAR210621"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const tripResponse = pm.response.json();",
              "pm.test('Expected response body', () => {",
              "pm.expect(tripResponse.length).to.eql(1);",
              "pm.expect(tripResponse[0].code).to.eql('CLAR210621');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing trip",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/DOESNOTEXIST"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const tripResponse = pm.response.json();",
              "pm.test('Expected response body', () => {",
              "pm.expect(tripResponse.message).to.eql('Trip not found.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown API route",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/unknown"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const tripResponse = pm.response.json();",
              "pm.test('Expected response body', () => {",
              "pm.expect(tripResponse.message).to.eql('API endpoint not found.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Travel page consumes API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/travel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Trips rendered with API links', () => {",
              "  pm.expect(pm.response.text()).to.include('Gale Reef');",
              "  pm.expect(pm.response.text()).to.include('/api/trips/GALR210214');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
